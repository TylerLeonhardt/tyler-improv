---
import "../styles/global.css";
import { Image } from "astro:assets";
import bioPhoto from "../assets/photos/tyler-bio.webp";
import HeroCarousel from "../components/HeroCarousel.astro";
import ShowCard from "../components/ShowCard.astro";
import { loadShowImages, loadShows } from "../lib/data";
import { splitShows } from "../lib/shows";

const siteUrl = String(Astro.site);
const shows = loadShows();
const images = loadShowImages();
// Build-time split; a tiny script below re-checks in the browser so a show
// moves to "Past" on its own even if the site hasn't been rebuilt.
const { upcoming, past } = splitShows(shows);

const title = "Tyler Leonhardt · Improv";
const description = "I'm Tyler Leonhardt, a Seattle-based improviser with Seattle Comedy Theater and Dollbrick Improv. Find my show dates, venues, and tickets.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f8f7f3" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={siteUrl} />
		<link rel="alternate" type="text/calendar" title="My shows" href="/shows.ics" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header frame">
			<a class="wordmark" href="/" aria-label="Tyler Leonhardt, home">Tyler Leonhardt<span aria-hidden="true">.</span></a>
			<nav aria-label="Main navigation">
				<a href="#shows">Shows</a>
				<a href="#about">About</a>
			</nav>
		</header>

		<main id="main" class="frame" tabindex="-1">
			<section class="hero" aria-labelledby="hero-heading">
				<h1 id="hero-heading">Tyler Leonhardt</h1>
			</section>

			<div class="shows-layout">
				<section id="shows" class="shows section" aria-labelledby="shows-heading">
					<div class="section-head">
						<div class="section-heading">
							<p class="eyebrow" aria-hidden="true">01 / Shows</p>
							<h2 id="shows-heading">Upcoming shows</h2>
							<p class="section-description">All times are Seattle local time.</p>
						</div>
						<a class="subscribe" href="/shows.ics" data-subscribe>Subscribe to calendar <span aria-hidden="true">↗</span></a>
					</div>

					<ol class="show-list" data-upcoming>
						{upcoming.map((show) => <ShowCard show={show} image={images.get(show.typeSlug)} siteUrl={siteUrl} />)}
					</ol>

					<div class="empty" data-empty hidden={upcoming.length > 0}>
						<p class="empty-title">No upcoming shows listed.</p>
						<p>Subscribe to the calendar for new dates.</p>
					</div>

					<details class="past" data-past hidden={past.length === 0}>
						<summary>Past shows <span class="count" data-past-count>{past.length}</span></summary>
						<ol class="show-list" data-past-list>
							{past.map((show) => <ShowCard show={show} image={images.get(show.typeSlug)} siteUrl={siteUrl} />)}
						</ol>
					</details>
				</section>
				<HeroCarousel />
			</div>

			<section id="about" class="bio section" aria-labelledby="about-heading">
				<div class="section-heading">
					<p class="eyebrow" aria-hidden="true">02 / About</p>
					<h2 id="about-heading">About</h2>
				</div>
				<div class="bio-content">
					<div class="bio-copy">
						<p>
							I’ve performed improv in Seattle since 2023. I’ve been part of the{" "}
							<a href="https://seattlecomedytheater.com">Seattle Comedy Theater</a> ensemble since 2025 and I’m a founding member of{" "}
							<a href="https://dollbrickimprov.com">Dollbrick Improv</a>.
						</p>
					</div>
					<Image
						class="bio-photo"
						src={bioPhoto}
						alt="Tyler in a denim shirt, performing beside warmly lit warehouse windows."
						widths={[160, 280, 400]}
						sizes="(min-width: 760px) 140px, 100px"
						loading="lazy"
					/>
				</div>
			</section>
		</main>

		<footer class="site-footer frame">
			<div>
				<p class="footer-name">Tyler Leonhardt</p>
			</div>
			<div class="footer-links">
				<a href="https://seattlecomedytheater.com">Seattle Comedy Theater</a>
				<a href="https://dollbrickimprov.com">Dollbrick Improv</a>
				<a href="/shows.ics">Calendar feed</a>
			</div>
		</footer>

		<script is:inline>
			(() => {
				const upcoming = document.querySelector("[data-upcoming]");
				const pastList = document.querySelector("[data-past-list]");
				let timer;
				function refreshShows() {
					clearTimeout(timer);
					const now = Date.now();
					const ended = [...upcoming.children].filter((li) => Date.parse(li.dataset.end) <= now);
					// Upcoming is oldest-first; past is newest-first.
					for (const li of ended) pastList.prepend(li);
					document.querySelector("[data-empty]").hidden = upcoming.children.length > 0;
					document.querySelector("[data-past]").hidden = pastList.children.length === 0;
					document.querySelector("[data-past-count]").textContent = String(pastList.children.length);
					const nextEnd = Math.min(...[...upcoming.children].map((li) => Date.parse(li.dataset.end)));
					if (Number.isFinite(nextEnd)) {
						timer = setTimeout(refreshShows, Math.min(nextEnd - now, 2_147_483_647));
					}
				}
				refreshShows();
				window.addEventListener("pageshow", refreshShows);
				document.addEventListener("visibilitychange", () => {
					if (!document.hidden) refreshShows();
				});
				const feed = `${location.host}/shows.ics`;
				document.querySelector("[data-subscribe]").href = `webcal://${feed}`;
			})();
		</script>
	</body>
</html>
