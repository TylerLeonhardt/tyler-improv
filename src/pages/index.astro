---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { Image } from "astro:assets";
import bioPhoto from "../assets/photos/tyler-bio.webp";
import heroPhoto from "../assets/photos/tyler-onstage.webp";
import jerseyPhoto from "../assets/photos/tyler-comedysportz.webp";
import scenePhoto from "../assets/photos/tyler-csz-seattle.webp";
import ShowCard from "../components/ShowCard.astro";
import { loadShowImages, loadShows } from "../lib/data";
import { splitShows } from "../lib/shows";

const siteUrl = String(Astro.site);
const shows = loadShows();
const images = loadShowImages();
// Build-time split; a tiny script below re-checks in the browser so a show
// moves to "Past" on its own even if the site hasn't been rebuilt.
const { upcoming, past } = splitShows(shows);

const title = "Tyler Leonhardt · Improv";
const description = "Seattle improviser. Come see a show! Upcoming dates for Seattle Comedy Theater, Dollbrick Improv, and more.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1c1814" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={siteUrl} />
		<link rel="alternate" type="text/calendar" title="Tyler's shows" href="/shows.ics" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
	</head>
	<body>
		<header class="hero">
			<Image
				class="hero-photo"
				src={heroPhoto}
				alt="Tyler throws his arms wide in front of a glowing red arched window as the crowd cheers."
				widths={[390, 640, 960]}
				sizes="(min-width: 640px) 65vw, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="bulbs" aria-hidden="true"></div>
			<div class="hero-inner">
				<p class="eyebrow">Improviser · Seattle</p>
				<h1>Tyler <em>Leonhardt</em></h1>
				<a class="hero-cta" href="#shows">
					When’s the next show? <span aria-hidden="true">↓</span>
				</a>
			</div>
		</header>

		<main>
			<section class="bio" aria-labelledby="about-heading">
				<h2 id="about-heading" class="section-label">About</h2>
				<Image
					class="bio-photo"
					src={bioPhoto}
					alt="Tyler performing in a dark denim shirt and rabbit tee, lit by warm stage lights beside warehouse windows."
					widths={[120, 176, 240, 320]}
					sizes="(min-width: 640px) 176px, 120px"
				/>
				<p>
					Tyler Leonhardt has been making things up on stage in Seattle since 2023, and has been part of the{" "}
					<a href="https://seattlecomedytheater.com">Seattle Comedy Theater</a> ensemble since 2025. He’s also a{" "}
					founding member of the indie group <a href="https://dollbrickimprov.com">Dollbrick Improv</a>.
				</p>
				<p>Nothing is scripted and no two shows are the same, so come catch one. He’d love to see you there.</p>
			</section>

			<section id="shows" class="shows" aria-labelledby="shows-heading">
				<div class="section-head">
					<h2 id="shows-heading" class="section-label">Upcoming shows</h2>
					<a class="subscribe" href="/shows.ics" data-subscribe>Subscribe</a>
				</div>

				<ol class="show-list" data-upcoming>
					{upcoming.map((show) => <ShowCard show={show} image={images.get(show.typeSlug)} siteUrl={siteUrl} />)}
				</ol>

				<div class="empty" data-empty hidden={upcoming.length > 0}>
					<p class="empty-title">No shows on the calendar right now.</p>
					<p>New dates land here as soon as they’re booked. Check back soon, or hit <em>Subscribe</em> to get them in your calendar automatically.</p>
				</div>

				<details class="past" data-past hidden={past.length === 0}>
					<summary>Past shows <span class="count" data-past-count>{past.length}</span></summary>
					<ol class="show-list" data-past-list>
						{past.map((show) => <ShowCard show={show} image={images.get(show.typeSlug)} siteUrl={siteUrl} />)}
					</ol>
				</details>
			</section>

			<section class="gallery" aria-labelledby="gallery-heading">
				<h2 id="gallery-heading" class="section-label">A few unscripted moments</h2>
				<div class="gallery-grid">
					<figure>
						<Image
							src={jerseyPhoto}
							alt="Tyler points finger guns at the camera in a red ComedySportz Seattle jersey against a brick wall."
							widths={[180, 360, 600, 720]}
							sizes="(min-width: 640px) 290px, calc((100vw - 3.5rem) / 2)"
							loading="lazy"
						/>
						<figcaption>Yes, and… finger guns.</figcaption>
					</figure>
					<figure>
						<Image
							src={scenePhoto}
							alt="Tyler mid-scene in his red jersey on the CSz Seattle stage, with colorful stools and a brick set behind him."
							widths={[180, 360, 600, 720]}
							sizes="(min-width: 640px) 290px, calc((100vw - 3.5rem) / 2)"
							loading="lazy"
						/>
						<figcaption>Making it up at CSz Seattle.</figcaption>
					</figure>
				</div>
			</section>
		</main>

		<footer>
			<p>
				<a href="https://seattlecomedytheater.com">Seattle Comedy Theater</a>
				<span aria-hidden="true">{" "}·{" "}</span>
				<a href="https://dollbrickimprov.com">Dollbrick Improv</a>
			</p>
			<p class="fine">Calendar feed: <a href="/shows.ics" data-feed-url>/shows.ics</a></p>
		</footer>

		<script is:inline>
			(() => {
				const now = Date.now();
				const upcoming = document.querySelector("[data-upcoming]");
				const pastList = document.querySelector("[data-past-list]");
				const ended = [...upcoming.children].filter((li) => Date.parse(li.dataset.end) <= now);
				// Upcoming is oldest-first; past is newest-first.
				for (const li of ended) pastList.prepend(li);
				document.querySelector("[data-empty]").hidden = upcoming.children.length > 0;
				document.querySelector("[data-past]").hidden = pastList.children.length === 0;
				document.querySelector("[data-past-count]").textContent = String(pastList.children.length);
				const feed = `${location.host}/shows.ics`;
				document.querySelector("[data-subscribe]").href = `webcal://${feed}`;
				const feedLink = document.querySelector("[data-feed-url]");
				feedLink.textContent = `${location.protocol}//${feed}`;
				feedLink.href = `${location.protocol}//${feed}`;
			})();
		</script>
	</body>
</html>
